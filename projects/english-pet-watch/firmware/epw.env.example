# 英语宠物怀表 · 本地环境配置模板
# 用法：cp epw.env.example epw.env，填真实值后运行 ui_demo/tools/sync_env.sh。
# epw.env 已被 .gitignore 忽略，不会提交；值含空格、# 或引号时用单引号包起来。

# Wi-Fi（仅 2.4GHz）
EPW_WIFI_SSID=''
EPW_WIFI_PASSWORD=''

# 语音服务端（xiaozhi-server v1 WebSocket，内含 VAD / ASR / LLM / TTS）
EPW_VOICE_WS_URL=''
EPW_VOICE_TOKEN=''

# 豆包宠物桥（可选；留空则只用本地情景引擎）
EPW_PET_BRIDGE_URL=''

# 3S 英语儿歌曲库根地址，例如 http://<服务器IP>:8083/family/modules/nursery/
EPW_NURSERY_BASE=''

# 自研固件 OTA / 发布脚本
EPW_OTA_URL=''
EPW_SERVER_HOST='vls'
EPW_SERVER_BIN_DIR=''
