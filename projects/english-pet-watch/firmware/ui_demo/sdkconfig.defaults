# 英语宠物怀表 · UI Demo 默认配置
# 目标板：Waveshare ESP32-S3-Touch-AMOLED-1.75C

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 32MB Flash / 8MB Octal PSRAM（实测）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 只把指令放入 PSRAM；完整中文字库与表情留在 Flash，避免挤占 UI/音频堆。
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
# CONFIG_SPIRAM_RODATA is not set
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# LVGL 9
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# 注意：LV_ATTRIBUTE_FAST_MEM_USE_IRAM 与 ESP-IDF 6.0 的 section 属性冲突
# （-Werror=attributes），保持关闭。

# 表盘用到的字号（Montserrat，ASCII）
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
# 中文字体含 GB2312 全集（6879 字形），bitmap 偏移超过 20bit，需要 LARGE 模式
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"

# 真机截图（Shot 调试功能，运行时由 CONFIG_EPW_BOOT_SHOTS 控制）
CONFIG_LV_USE_SNAPSHOT=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# 串口截图/日志吞吐：UART0 主控制台提速（USB-JTAG 从控制台同步镜像）
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# 网络 JSON 仅需少量嵌套，限制解析器递归深度以保护任务栈。
CONFIG_CJSON_NESTING_LIMIT=16

# 录音上传不与接收回调争用同一个锁。
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y

# 热点网络校时：国内主备 NTP，HTTP Date 仅用于首次校时兜底。
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# mbedTLS 缓冲区放 PSRAM：内部 RAM 要留给 LVGL 绘制与音频 DMA。
# 默认 INTERNAL 模式下 TLS 输入 16KB + 输出 4KB 只能挤内部 RAM，
# 萧山天气 HTTPS 建链时 mbedtls_ssl_setup 会因内存不足返回 -0x008D。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
