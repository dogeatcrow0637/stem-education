# 英语宠物怀表 · 自研固件默认配置
# 目标板：Waveshare ESP32-S3-Touch-AMOLED-1.75C（ESP32-S3 rev v0.2，32MB Flash / 8MB PSRAM，实测）

CONFIG_IDF_TARGET="esp32s3"

# Flash：32MB（实板 GD c8/4019），QIO 80MHz
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM：8MB Octal PSRAM（V0.2 音频缓冲与屏幕帧缓冲要用）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# 自定义分区表：双 OTA 槽
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA 允许 http（局域网联调）；公网部署应改用 https
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# OTA 任务会做 JSON 解析与日志，主任务栈给足
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
